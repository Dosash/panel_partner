# ───────── Веб-панель ─────────
# 127.0.0.1 — панель доступна только с этого компьютера/сервера (открывать через SSH-туннель или nginx);
# 0.0.0.0 — доступна из сети. Пароля у панели нет — не открывайте её в интернет без nginx с авторизацией.
WEB_HOST=127.0.0.1
WEB_PORT=8097

# Путь панели, если она открыта не в корне сайта (например, /partners → http://сервер/partners/). Пусто — в корне.
WEB_PREFIX=

# Ссылка «← Все панели» в меню (если у вас несколько панелей за одним nginx), например /. Пусто — без ссылки.
HUB_URL=

# ───────── Хранение ─────────
DB_PATH=data/partners.db
LOG_LEVEL=INFO
